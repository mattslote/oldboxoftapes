{
  "name": "oldboxoftapes",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "oldboxoftapes.com", "custom_domain": true },
    { "pattern": "www.oldboxoftapes.com", "custom_domain": true }
  ],
  "send_email": [
    { "name": "EMAIL", "destination_address": "matt@12acrefilms.com" }
  ],
  "vars": {
    "TO_ADDRESS": "matt@12acrefilms.com",
    "FROM_ADDRESS": "website@pxlstream.com"
  }
}
